meta {
  name: Applications - Invalid Profile
  type: http
  seq: 19
}

put {
  url: {{API_URL}}/v3/applications/{{CreatedApplicationId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": {{CreatedApplicationId}},
    "applicationName": "Updated Application Name",
    "vendorId": {{OtherApplicationVendorId}},
    "claimSetName": "{{UpdatedApplicationClaimSetName}}",
    "profileIds": [9999],
    "educationOrganizationIds": [1234]
  }

}

script:post-response {
  test("PUT Application Invalid Profile: Status code is Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });

  const response = res.getBody();

  test("PUT Application Invalid Profile: Response matches error format", function () {
      expect(response).to.have.property("title");
      expect(response).to.have.property("detail");
  });

  test("PUT Application Invalid Profile: Response title is helpful and accurate", function () {
      expect(response.title.toLowerCase()).to.contain("conflict");
  });

  test("PUT Application Invalid Profile: Response detail describes the conflict", function () {
      expect(response.detail).to.contain("The following ProfileIds were not found in database");
  });

  test("PUT Application Invalid Profile: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:conflict:unresolved-reference");
  });
}

settings {
  encodeUrl: true
}
