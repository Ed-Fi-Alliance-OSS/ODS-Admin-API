meta {
  name: Applications - Enabled And DataStore Ignored
  type: http
  seq: 20
}

put {
  url: {{API_URL}}/v3/applications/{{CreatedApplicationId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": {{CreatedApplicationId}},
    "applicationName": "Updated Application Name",
    "vendorId": {{OtherApplicationVendorId}},
    "claimSetName": "{{UpdatedApplicationClaimSetName}}",
    "profileIds": [],
    "educationOrganizationIds": [1234],
    "enabled": false,
    "dataStoreIds": [ 9999 ]
  }

}

script:post-response {
  // ADMINAPI-1484: enabled and dataStoreIds are per-ApiClient concerns now, so
  // PUT /v3/applications/{id} no longer reads or validates either one - even a
  // non-existent dataStoreId (9999) no longer causes a validation error, and
  // this succeeds instead of the 400 it used to return.
  test("PUT Application Enabled/DataStore Ignored: Status code is No Content", function () {
      expect(res.getStatus()).to.equal(204);
  });

  const axios = require('axios');
  const API_URL = bru.getEnvVar("API_URL");
  const TOKEN = bru.getEnvVar("TOKEN");

  const axiosConfig = {
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${TOKEN}`
    },
    validateStatus: function (status) {
      return status < 500;
    },
    timeout: 30000
  };

  if (bru.getEnvVar("isMultitenant") == "true") {
    axiosConfig.headers['Tenant'] = `${bru.getEnvVar("tenant1")}`;
  }

  try {
    const applicationId = bru.getVar("CreatedApplicationId");
    const applicationResponse = await axios.get(`${API_URL}/v3/applications/${applicationId}`, axiosConfig);

    if (applicationResponse.status === 200) {
      test("PUT Application Enabled/DataStore Ignored: enabled/dataStoreIds remain unchanged", function () {
          expect(applicationResponse.data.enabled).to.equal(true);
          expect(applicationResponse.data.dataStoreIds.length).to.equal(1);
          expect(applicationResponse.data.dataStoreIds).to.not.include(9999);
      });
    } else {
      throw new Error(`Failed to get application - Status: ${applicationResponse.status}, Data: ${JSON.stringify(applicationResponse.data)}`);
    }
  } catch (error) {
    console.log("Error in post-request verification:", error.message);
  }
}

settings {
  encodeUrl: true
}
