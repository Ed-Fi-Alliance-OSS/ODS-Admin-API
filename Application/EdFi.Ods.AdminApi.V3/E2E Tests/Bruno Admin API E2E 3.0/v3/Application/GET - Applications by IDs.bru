meta {
  name: Applications by IDs
  type: http
  seq: 14
}

get {
  url: {{API_URL}}/v3/applications?ids={{FirstTwoApplicationIdsCSV}}
  body: none
  auth: inherit
}

params:query {
  ids: {{FirstTwoApplicationIdsCSV}}
}

script:post-response {
  test("GET ApplicationID: Status code is OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const result = res.getBody();
  const requestedIds = [...new Set(
    (bru.getVar("FirstTwoApplicationIdsCSV") || "")
      .split(",")
      .map(id => Number(id.trim()))
      .filter(Number.isInteger)
  )];
  
  test("GET ApplicationID: Ensures returned applications exactly match requested IDs", function () {
    expect(requestedIds.length).to.be.greaterThan(0);
    expect(result.length).to.equal(requestedIds.length);

    const resultIds = result.map(function(application) { return application.id; });
    requestedIds.forEach(function(id) {
      expect(resultIds).to.include(id);
    });
  });
}

settings {
  encodeUrl: true
}
