meta {
  name: Applications - Invalid DataStore
  type: http
  seq: 6
}

post {
  url: {{API_URL}}/v3/applications/
  body: json
  auth: inherit
}

body:json {
  {
    "applicationName": "Test Application Invalid DataStore",
    "vendorId": {{ApplicationVendorId}},
    "claimSetName": "{{ApplicationClaimSetName}}",
    "profileIds": [ ],
    "educationOrganizationIds": [ 255901 ],
    "dataStoreIds": [ 99999 ]
  }
  
}

script:post-response {
  test("POST Applications Invalid DataStore: Status code is Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });

  const response = res.getBody();

  test("POST Applications Invalid DataStore: Response matches error format", function () {
      expect(response).to.have.property("title");
      expect(response).to.have.property("detail");
  });

  test("POST Applications Invalid DataStore: Response title is helpful and accurate", function () {
      expect(response.title.toLowerCase()).to.contain("conflict");
  });

  test("POST Applications Invalid DataStore: Response detail describes the conflict", function () {
      expect(response.detail).to.contain("The following DataStoreIds were not found in database");
  });

  test("POST Applications Invalid DataStore: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:conflict:unresolved-reference");
  });
}

settings {
  encodeUrl: true
}
