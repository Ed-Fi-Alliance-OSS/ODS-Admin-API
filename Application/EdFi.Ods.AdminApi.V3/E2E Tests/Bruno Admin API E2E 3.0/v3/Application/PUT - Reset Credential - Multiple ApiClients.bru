meta {
  name: Reset Credential - Multiple ApiClients
  type: http
  seq: 21.2
}

put {
  url: {{API_URL}}/v3/applications/{{CreatedApplicationId}}/reset-credential
  body: none
  auth: inherit
}

script:pre-request {
  console.log("🔧 Setting pre environment to ignore SSL certificates...");

  try {
    if (typeof process !== 'undefined' && process.env) {
      process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';
    }
  } catch (e) {
    // Ignore in UI environment
  }

  const axios = require('axios');
  const API_URL = bru.getEnvVar("API_URL");
  const TOKEN = bru.getEnvVar("TOKEN");

  const axiosConfig = {
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${TOKEN}`
    },
    validateStatus: function (status) {
      return status < 500;
    },
    timeout: 30000
  };

  if (bru.getEnvVar("isMultitenant") == "true") {
    axiosConfig.headers['Tenant'] = `${bru.getEnvVar("tenant1")}`;
  }

  // ADMINAPI-1484: give the Application a second ApiClient, so the
  // reset-credential request below is genuinely ambiguous about which
  // credential to reset.
  try {
    const apiClientResp = await axios.post(`${API_URL}/v3/apiClients`, {
      "name": `Second Credential ${Date.now()}`,
      "isApproved": true,
      "applicationId": bru.getVar("CreatedApplicationId"),
      "dataStoreIds": [ bru.getVar("DataStoreId") ]
    }, axiosConfig);

    if (apiClientResp.status !== 201) {
      throw new Error(`Failed to create second ApiClient - Status: ${apiClientResp.status}, Data: ${JSON.stringify(apiClientResp.data)}`);
    }
    console.log("✅ Second ApiClient created successfully");
  } catch (error) {
    console.log("Error in pre-request setup:", error.message);
    throw error;
  }
}

script:post-response {
  test("PUT Reset Credential Multiple ApiClients: Status code is Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });

  const response = res.getBody();

  test("PUT Reset Credential Multiple ApiClients: Response matches error format", function () {
      expect(response).to.have.property("title");
      expect(response).to.have.property("detail");
  });

  test("PUT Reset Credential Multiple ApiClients: Response detail directs caller to the per-credential endpoint", function () {
      expect(response.detail).to.contain("more than one ApiClient");
      expect(response.detail).to.contain("/v3/apiClients/{id}/reset-credential");
  });

  test("PUT Reset Credential Multiple ApiClients: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:bad-request");
  });
}

settings {
  encodeUrl: true
}
