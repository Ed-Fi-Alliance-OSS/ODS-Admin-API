meta {
  name: Applications - Invalid Vendor
  type: http
  seq: 4
}

post {
  url: {{API_URL}}/v3/applications/
  body: json
  auth: inherit
}

body:json {
  {
    "applicationName": "Test Application",
    "vendorId": 9999,
    "claimSetName": "{{ApplicationClaimSetName}}",
    "profileIds": [],
    "educationOrganizationIds": [ 255901 ],
    "dataStoreIds": [ {{DataStoreId}} ]
  }
  
}

script:post-response {
  test("POST Applications Invalid Vendor: Status code is Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });

  const response = res.getBody();

  test("POST Applications Invalid Vendor: Response matches error format", function () {
      expect(response).to.have.property("title");
      expect(response).to.have.property("detail");
  });

  test("POST Applications Invalid Vendor: Response title is helpful and accurate", function () {
      expect(response.title.toLowerCase()).to.contain("conflict");
  });

  test("POST Applications Invalid Vendor: Response detail describes the conflict", function () {
      expect(response.detail).to.contain("Vendor with ID 9999 not found.");
  });

  test("POST Applications Invalid Vendor: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:conflict:unresolved-reference");
  });
}

settings {
  encodeUrl: true
}
