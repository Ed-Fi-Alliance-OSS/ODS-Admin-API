meta {
  name: POST - Application No Default Credentials
  type: http
  seq: 2
}

post {
  url: {{API_URL}}/v3/applications
  body: json
  auth: inherit
}

body:json {
  {
    "applicationName": "EdOrg Scope Application",
    "vendorId": {{EdOrgVendorId}},
    "claimSetName": "{{EdOrgClaimSetName}}",
    "profileIds": [],
    "educationOrganizationIds": [255901, 255902],
    "createDefaultCredentials": false
  }
}

script:post-response {
  test("POST Application createDefaultCredentials false: Status code is Created", function () {
      expect(res.getStatus()).to.equal(201);
  });

  const result = res.getBody();
  test("POST Application createDefaultCredentials false: key and secret are null", function () {
      expect(result).to.have.property("id");
      expect(result.key).to.equal(null);
      expect(result.secret).to.equal(null);
  });

  const location = res.getHeaders().location;
  if (location) {
      bru.setVar("EdOrgApplicationId", String(location).split("/").pop());
  }
}

settings {
  encodeUrl: true
}
