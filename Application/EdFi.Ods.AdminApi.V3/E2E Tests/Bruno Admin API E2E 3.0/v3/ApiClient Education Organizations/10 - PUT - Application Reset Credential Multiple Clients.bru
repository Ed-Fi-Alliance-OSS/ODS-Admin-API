meta {
  name: PUT - Application Reset Credential Multiple Clients
  type: http
  seq: 10
}

put {
  url: {{API_URL}}/v3/applications/{{EdOrgApplicationId}}/reset-credential
  body: none
  auth: inherit
}

script:post-response {
  test("PUT Application reset credential with more than one client: Status code is Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });

  const response = res.getBody();
  test("PUT Application reset credential with more than one client: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:conflict");
  });
}

settings {
  encodeUrl: true
}
