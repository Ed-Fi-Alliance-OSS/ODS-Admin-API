meta {
  name: POST - ApiClient Education Organization Not On Application
  type: http
  seq: 6
}

post {
  url: {{API_URL}}/v3/apiClients
  body: json
  auth: inherit
}

body:json {
  {
    "name": "EdOrg Scope Client Invalid",
    "isApproved": true,
    "applicationId": {{EdOrgApplicationId}},
    "dataStoreIds": [{{EdOrgDataStoreId}}],
    "educationOrganizationIds": [999]
  }
}

script:post-response {
  test("POST ApiClient not on Application: Status code is Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });

  const response = res.getBody();
  test("POST ApiClient not on Application: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:bad-request:data");
  });
}

settings {
  encodeUrl: true
}
