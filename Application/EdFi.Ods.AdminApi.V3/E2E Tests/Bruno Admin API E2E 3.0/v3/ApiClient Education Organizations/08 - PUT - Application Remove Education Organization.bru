meta {
  name: PUT - Application Remove Education Organization
  type: http
  seq: 8
}

put {
  url: {{API_URL}}/v3/applications/{{EdOrgApplicationId}}
  body: json
  auth: inherit
}

body:json {
  {
    "id": {{EdOrgApplicationId}},
    "applicationName": "EdOrg Scope Application",
    "vendorId": {{EdOrgVendorId}},
    "claimSetName": "{{EdOrgClaimSetName}}",
    "profileIds": [],
    "educationOrganizationIds": [255902, 255903]
  }
}

script:post-response {
  test("PUT Application remove education organization: Status code is No Content", function () {
      expect(res.getStatus()).to.equal(204);
  });

  try {
    if (typeof process !== 'undefined' && process.env) {
      process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';
    }
  } catch (e) {
    // Ignore in UI environment
  }

  const axios = require('axios');
  const API_URL = bru.getEnvVar("API_URL");
  const axiosConfig = {
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${bru.getEnvVar("TOKEN")}`
    },
    validateStatus: function (status) {
      return status < 500;
    },
    timeout: 30000
  };

  if (bru.getEnvVar("isMultitenant") == "true") {
    axiosConfig.headers['Tenant'] = `${bru.getEnvVar("tenant1")}`;
  }

  const clientResponse = await axios.get(`${API_URL}/v3/apiClients/${bru.getVar("EdOrgClientId")}`, axiosConfig);
  test("PUT Application remove education organization: narrowed client is []", function () {
      expect(clientResponse.status).to.equal(200);
      expect(clientResponse.data.educationOrganizationIds).to.deep.equal([]);
  });
}

settings {
  encodeUrl: true
}
