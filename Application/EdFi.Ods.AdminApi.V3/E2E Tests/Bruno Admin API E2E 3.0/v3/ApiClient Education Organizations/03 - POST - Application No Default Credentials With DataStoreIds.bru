meta {
  name: POST - Application No Default Credentials With DataStoreIds
  type: http
  seq: 3
}

post {
  url: {{API_URL}}/v3/applications
  body: json
  auth: inherit
}

body:json {
  {
    "applicationName": "EdOrg Scope Application Invalid",
    "vendorId": {{EdOrgVendorId}},
    "claimSetName": "{{EdOrgClaimSetName}}",
    "profileIds": [],
    "educationOrganizationIds": [255901],
    "dataStoreIds": [{{EdOrgDataStoreId}}],
    "createDefaultCredentials": false
  }
}

script:post-response {
  test("POST Application createDefaultCredentials false with dataStoreIds: Status code is Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });

  const response = res.getBody();
  test("POST Application createDefaultCredentials false with dataStoreIds: type URN is correct", function () {
      expect(response.type).to.equal("urn:ed-fi:management-api:bad-request:data");
  });
}

settings {
  encodeUrl: true
}
